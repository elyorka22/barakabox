PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/barakabox
JWT_ACCESS_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
CORS_ORIGIN=https://app.example.uz
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
DELIVERY_FEE=3000
EXPRESS_DELIVERY_FEE=15000
FREE_DELIVERY_THRESHOLD=30000
ORDER_IDEMPOTENCY_WINDOW_SECONDS=120
# S3-compatible object storage (DigitalOcean Spaces, Cloudflare R2, AWS S3)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# R2 example: https://<account_id>.r2.cloudflarestorage.com (set SPACES_REGION per provider docs)
SPACES_REGION=us-east-1
SPACES_BUCKET=barakabox-storage
SPACES_KEY=replace-with-spaces-key
SPACES_SECRET=replace-with-spaces-secret
# Optional CDN/public URL (recommended for R2 custom domain)
SPACES_CDN_URL=
# Set to true only after verifying orphan-detection includes all referenced keys (default: false)
UPLOAD_ORPHAN_CLEANUP_ENABLED=false
# When true, backend exits if Spaces bucket is unreachable at startup
UPLOAD_STARTUP_STRICT=false
ALERT_WEBHOOK_URL=
UPLOAD_ERROR_RATE_THRESHOLD=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
UPLOAD_CIRCUIT_BREAKER_THRESHOLD=5
UPLOAD_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60
UPLOAD_CIRCUIT_HALF_OPEN_MAX_REQUESTS=1
UPLOAD_MONTHLY_STORAGE_LIMIT_BYTES=5368709120
UPLOAD_BLOCK_ON_COST_LIMIT=true

# Analytics: events stored in Postgres; Redis used for online-user presence
