generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  BUSINESS
  ADMIN
  COURIER
  PICKER
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  NEW
  PICKING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

enum UnitType {
  kg
  piece
  pack
}

enum InventoryReason {
  INCOME
  SALE
  ADJUSTMENT
}

enum UploadAuditAction {
  PRESIGN
  FINALIZE
  DELETE
  LEGACY_UPLOAD
  RETRY
}

enum FailedJobStatus {
  PENDING
  RETRYING
  RESOLVED
  FAILED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(CLIENT)
  refreshToken    String?
  fullName        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessProfile BusinessProfile?
  cart            Cart?
  orders          Order[]
  pickerOrders    Order[]          @relation("PickerAssignments")
  courierOrders   Order[]          @relation("CourierAssignments")
  uploadAuditLogs UploadAuditLog[]

  @@index([role])
}

model BusinessProfile {
  id          String         @id @default(cuid())
  userId      String         @unique
  displayName String
  phone       String?
  isActive    Boolean        @default(true)
  status      BusinessStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([status])
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  categoryId   String?
  name         String
  description  String?
  imageUrl     String?
  imageKey     String?
  imageCardUrl String?
  imageCardKey String?
  imageThumbUrl String?
  imageThumbKey String?
  unitType     UnitType @default(piece)
  price        Int
  stockQuantity Int     @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  boxItems     BoxItem[]
  inventoryLogs InventoryLog[]
  imageAssets   ProductImageAsset[]
  uploadSession UploadSession?
  uploadAuditLogs UploadAuditLog[]
  variants     ProductVariant[]

  @@index([businessId])
  @@index([categoryId])
  @@index([isActive])
}

model ProductImageAsset {
  id           String   @id @default(cuid())
  productId     String
  mainUrl       String
  mainKey       String
  cardUrl       String
  cardKey       String
  thumbUrl      String
  thumbKey      String
  totalBytes    Int
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model UploadSession {
  id         String   @id @default(cuid())
  productId  String   @unique
  mainUrl    String
  mainKey    String
  cardUrl    String
  cardKey    String
  thumbUrl   String
  thumbKey   String
  mainSize   Int
  cardSize   Int
  thumbSize  Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model UploadAuditLog {
  id         String          @id @default(cuid())
  userId     String
  productId  String?
  action     UploadAuditAction
  objectKey  String?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([action, createdAt])
}

model FailedUploadJob {
  id          String          @id @default(cuid())
  operation   String
  payload     Json
  error       String
  status      FailedJobStatus @default(PENDING)
  retryCount  Int             @default(0)
  lastTriedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Category {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  imageUrl   String?
  sortOrder  Int       @default(0)
  isFeatured Boolean   @default(true)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]

  @@index([isActive])
  @@index([sortOrder])
}

model Box {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       BoxItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([isActive])
}

model BoxItem {
  id        String   @id @default(cuid())
  boxId     String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([boxId, productId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  variantId String?
  boxId     String?
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  box       Box?     @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@unique([cartId, boxId])
  @@index([productId])
  @@index([variantId])
  @@index([boxId])
}

model Order {
  id            String      @id @default(cuid())
  userId        String?
  assignedPickerId String?
  assignedCourierId String?
  customerName  String
  customerPhone String
  deliveryAddress String
  status        OrderStatus @default(NEW)
  pickingAt     DateTime?
  readyAt       DateTime?
  deliveringAt  DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  idempotencyKey String
  subtotalAmount Int
  deliveryFee   Int
  totalAmount   Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedPicker User?      @relation("PickerAssignments", fields: [assignedPickerId], references: [id], onDelete: SetNull)
  assignedCourier User?     @relation("CourierAssignments", fields: [assignedCourierId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  inventoryLogs InventoryLog[]

  @@index([userId, status])
  @@index([idempotencyKey, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  boxId      String?
  quantity   Int
  price      Int
  title      String
  variantSnapshotTitle String?
  variantSnapshotFlavor String?
  variantSnapshotSize String?
  variantSnapshotSku String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  box        Box?     @relation(fields: [boxId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([boxId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId     String
  title         String
  flavor        String?
  size          String?
  sku           String?
  barcode       String?
  description   String?
  price         Int
  discountPrice Int?
  stock         Int      @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId, isActive])
  @@index([sku])
  @@index([barcode])
}

model InventoryLog {
  id         String          @id @default(cuid())
  productId  String
  orderId    String?
  change     Int
  reason     InventoryReason
  createdAt  DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId, createdAt])
}
