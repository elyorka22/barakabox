generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  SUPER_ADMIN
  ADMIN
  MANAGER
  STORE_OWNER
  BUSINESS
  COURIER
  PICKER
}

enum BusinessStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
}

enum OrderStatus {
  PENDING_SCHEDULE
  NEW
  PICKING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  INSTANT
  SCHEDULED
}

enum UnitType {
  dona
  kg
  gramm
  litr
  ml
  quti
  karobka
  paket
  toplam
  bog
  pack
}

/// Sale unit stored on Product (subset of legacy UnitType used on OrderItem snapshots).
enum ProductUnit {
  dona
  kg
  gramm
  litr
  ml
  quti
  karobka
  toplam
}

/// How a product is sold from the cart: piece, gram steps, or kilogram steps.
/// Decoupled from `unit` (price label) so admin can sell potatoes by kilo and pistachio by gram.
enum SellingMode {
  PIECE
  GRAM_STEP
  KILOGRAM_STEP
}

enum InventoryReason {
  INCOME
  SALE
  ADJUSTMENT
}

enum UploadAuditAction {
  PRESIGN
  FINALIZE
  DELETE
  LEGACY_UPLOAD
  RETRY
}

enum FailedJobStatus {
  PENDING
  RETRYING
  RESOLVED
  FAILED
}

enum CashbackType {
  NONE
  PERCENT
  FIXED_AMOUNT
}

enum PromotionBadge {
  HOT
  TOP
  YANGI
  AKSIYA
  PREMIUM
}

enum CashbackTransactionType {
  EARNED
  SPENT
  EXPIRED
  REFUND
}

enum CashbackTransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CouponDiscountType {
  PERCENT
  FIXED_AMOUNT
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  role            Role             @default(CLIENT)
  refreshToken    String?
  fullName        String
  /// Internal login (e.g. courier_1). Optional; staff may sign in with this or email.
  staffLogin      String?          @unique
  phone           String?
  isActive        Boolean          @default(true)
  /// Legacy scope: courier/picker tied to BusinessProfile (prefer storeScopeId for pickers).
  businessScopeId String?
  /// Store scope for pickers — required for new PICKER accounts.
  storeScopeId    String?
  lastLoginAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  businessProfile BusinessProfile?
  businessScope   BusinessProfile? @relation("BusinessStaffScope", fields: [businessScopeId], references: [id], onDelete: SetNull)
  storeScope      Store?           @relation("StoreStaffScope", fields: [storeScopeId], references: [id], onDelete: SetNull)
  ownedStores     Store[]          @relation("StoreOwner")
  cart            Cart?
  orders          Order[]
  pickerOrders    Order[]          @relation("PickerAssignments")
  courierOrders   Order[]          @relation("CourierAssignments")
  courierRejects  CourierOrderReject[]
  courierShifts   CourierShift[]
  uploadAuditLogs UploadAuditLog[]
  customerProfile Customer?

  @@index([role])
  @@index([businessScopeId])
  @@index([storeScopeId])
}

model CourierOrderReject {
  id        String   @id @default(cuid())
  courierId String
  orderId   String
  reason    String?
  createdAt DateTime @default(now())
  courier   User     @relation(fields: [courierId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([courierId, createdAt])
  @@index([orderId, courierId])
}

model CourierShift {
  id        String    @id @default(cuid())
  courierId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  courier   User      @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, startedAt])
  @@index([courierId, endedAt])
}

model Customer {
  id               String   @id @default(cuid())
  phone            String   @unique
  name             String?
  cashbackBalance  Int      @default(0)
  totalSpent       Int      @default(0)
  totalOrders      Int      @default(0)
  userId           String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders           Order[]
  cashbackTransactions CashbackTransaction[]
  addresses        CustomerAddress[]
  couponRedemptions CouponRedemption[]

  @@index([phone])
}

model Coupon {
  id             String             @id @default(cuid())
  code           String             @unique
  discountType   CouponDiscountType
  discountValue  Int
  minOrderAmount Int                @default(0)
  maxDiscount    Int?
  usageLimit     Int?
  usedCount      Int                @default(0)
  perUserLimit   Int                @default(1)
  expiresAt      DateTime?
  isActive       Boolean            @default(true)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  orders         Order[]
  redemptions    CouponRedemption[]

  @@index([isActive])
  @@index([expiresAt])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  customerId String?
  orderId    String   @unique
  phone      String?
  createdAt  DateTime @default(now())
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([customerId])
  @@index([phone, couponId])
}

model CashbackTransaction {
  id         String                    @id @default(cuid())
  customerId String
  orderId    String?
  amount     Int
  type       CashbackTransactionType
  status     CashbackTransactionStatus @default(COMPLETED)
  createdAt  DateTime                  @default(now())
  customer   Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?                    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([customerId, createdAt])
  @@index([orderId])
}

model BusinessProfile {
  id          String         @id @default(cuid())
  userId      String         @unique
  displayName String
  phone       String?
  address     String?
  description String?
  logoUrl     String?
  isActive    Boolean        @default(true)
  status      BusinessStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  products    Product[]
  scopedStaff User[]         @relation("BusinessStaffScope")
  /// Populated when legacy business is linked to a marketplace Store (Stage 4 migration).
  store       Store?

  @@index([status])
}

model Product {
  id           String   @id @default(cuid())
  businessId   String
  categoryId   String?
  name         String
  description  String?
  imageUrl     String?
  imageKey     String?
  imageCardUrl String?
  imageCardKey String?
  imageThumbUrl String?
  imageThumbKey String?
  unit         ProductUnit @default(dona)
  sellingMode  SellingMode @default(PIECE)
  stepAmount   Int?
  minimumAmount Int?
  price        Int
  discountEnabled Boolean @default(false)
  discountedPrice Int?
  promotionBadge  PromotionBadge?
  promotionEnabled Boolean @default(false)
  promotionStartAt DateTime?
  promotionEndAt   DateTime?
  stockQuantity Int     @default(0)
  isActive     Boolean  @default(true)
  isTopProduct Boolean  @default(false)
  topOrder     Int      @default(0)
  topBadge     String?
  cashbackType    CashbackType @default(NONE)
  cashbackValue   Int          @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems    CartItem[]
  orderItems   OrderItem[]
  boxItems     BoxItem[]
  inventoryLogs InventoryLog[]
  imageAssets   ProductImageAsset[]
  uploadSession UploadSession?
  uploadAuditLogs UploadAuditLog[]
  variants     ProductVariant[]

  @@index([businessId])
  @@index([categoryId])
  @@index([isActive])
  @@index([discountEnabled, discountedPrice])
  @@index([promotionEnabled])
  @@index([isTopProduct, topOrder])
}

model ProductImageAsset {
  id           String   @id @default(cuid())
  productId     String
  mainUrl       String
  mainKey       String
  cardUrl       String
  cardKey       String
  thumbUrl      String
  thumbKey      String
  totalBytes    Int
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model UploadSession {
  id         String   @id @default(cuid())
  productId  String   @unique
  mainUrl    String
  mainKey    String
  cardUrl    String
  cardKey    String
  thumbUrl   String
  thumbKey   String
  mainSize   Int
  cardSize   Int
  thumbSize  Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model UploadAuditLog {
  id         String          @id @default(cuid())
  userId     String
  productId  String?
  action     UploadAuditAction
  objectKey  String?
  createdAt  DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([action, createdAt])
}

model FailedUploadJob {
  id          String          @id @default(cuid())
  operation   String
  payload     Json
  error       String
  status      FailedJobStatus @default(PENDING)
  retryCount  Int             @default(0)
  lastTriedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Category {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  imageUrl        String?
  sortOrder       Int             @default(0)
  isFeatured      Boolean         @default(true)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  products        Product[]
  globalProducts  GlobalProduct[]

  @@index([isActive])
  @@index([sortOrder])
}

model Box {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Int
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  items       BoxItem[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([isActive])
}

model BoxItem {
  id        String   @id @default(cuid())
  boxId     String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  box       Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([boxId, productId])
  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String?
  variantId String?
  boxId     String?
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  box       Box?     @relation(fields: [boxId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@unique([cartId, boxId])
  @@index([productId])
  @@index([variantId])
  @@index([boxId])
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  label      String
  address    String   @default("")
  latitude   Float
  longitude  Float
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String?     @unique
  trackingToken String?   @unique
  /// Marketplace storefront that originated the cart (Stage 13).
  storeId       String?
  userId        String?
  customerId    String?
  assignedPickerId String?
  assignedCourierId String?
  customerName  String
  customerPhone String
  deliveryAddress String
  latitude      Float?
  longitude     Float?
  formattedAddress String?
  manualAddress String?
  deliveryNote  String?
  addressLabel  String?
  status        OrderStatus @default(NEW)
  deliveryType  DeliveryType @default(INSTANT)
  isScheduled   Boolean     @default(false)
  scheduledAt   DateTime?
  scheduledSlotEnd DateTime?
  deliverySlot  String?
  pickingAt     DateTime?
  readyAt       DateTime?
  deliveringAt  DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  idempotencyKey String
  subtotalAmount Int
  deliveryFee   Int
  totalAmount   Int
  cashbackRedeemTiyin          Int       @default(0)
  cashbackEarnedSnapshotTiyin Int       @default(0)
  cashbackCreditedAt          DateTime?
  couponId                    String?
  couponCode                  String?
  couponDiscountTiyin         Int       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedPicker User?      @relation("PickerAssignments", fields: [assignedPickerId], references: [id], onDelete: SetNull)
  assignedCourier User?     @relation("CourierAssignments", fields: [assignedCourierId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  inventoryLogs InventoryLog[]
  cashbackTransactions CashbackTransaction[]
  courierRejects CourierOrderReject[]
  coupon         Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?
  store          Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([storeId, createdAt])
  @@index([couponId])
  @@index([customerId])
  @@index([idempotencyKey, createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String?
  variantId  String?
  boxId      String?
  unitType   UnitType @default(dona)
  sellingMode SellingMode @default(PIECE)
  quantity   Int
  price      Int
  title      String
  variantSnapshotTitle String?
  variantSnapshotFlavor String?
  variantSnapshotSize String?
  variantSnapshotSku String?
  cashbackPendingTiyin Int @default(0)
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  box        Box?     @relation(fields: [boxId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([boxId])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId     String
  title         String
  flavor        String?
  size          String?
  sku           String?
  barcode       String?
  description   String?
  price         Int
  discountPrice Int?
  stock         Int      @default(0)
  imageUrl      String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId, isActive])
  @@index([sku])
  @@index([barcode])
  @@index([discountPrice])
}

model InventoryLog {
  id         String          @id @default(cuid())
  productId  String
  orderId    String?
  change     Int
  reason     InventoryReason
  createdAt  DateTime        @default(now())
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId, createdAt])
}

model Banner {
  id              String   @id @default(cuid())
  title           String?
  subtitle        String?
  imageUrl        String?
  buttonText      String?
  buttonLink      String?
  backgroundColor String?
  textColor       String?
  overlayOpacity  Int      @default(0)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model SiteSettings {
  id                 String   @id @default("global")
  supportTelegramUrl String?
  supportTitle       String?
  deliveryPrice      Int      @default(15000)
  freeDeliveryEnabled Boolean @default(true)
  freeDeliveryThreshold Int   @default(350000)
  scheduledOrdersEnabled Boolean @default(true)
  scheduleSlotMinutes Int      @default(60)
  scheduleWorkStartHour Int    @default(9)
  scheduleWorkEndHour Int      @default(21)
  scheduleMinDelayMinutes Int  @default(60)
  scheduleMaxOrdersPerSlot Int @default(20)
  schedulePrepLeadMinutes Int  @default(30)
  updatedAt          DateTime @updatedAt
}

model HomepageBanner {
  id                 String   @id @default("default")
  title              String   @default("")
  subtitle           String?
  freeDeliveryAmount Int      @default(50000)
  backgroundColor    String   @default("#F2E5CC")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

/// First-party behavioral analytics (batched from storefront).
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  sessionId  String
  userId     String?
  guestId    String?
  path       String?
  properties Json     @default("{}")
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Pre-aggregated daily metrics for fast admin dashboards.
model AnalyticsDailyMetric {
  id         String   @id @default(cuid())
  dateKey    String
  metric     String
  dimension  String   @default("")
  value      Int      @default(0)
  valueFloat Float?
  updatedAt  DateTime @updatedAt

  @@unique([dateKey, metric, dimension])
  @@index([dateKey, metric])
}

// ---------------------------------------------------------------------------
// Multi-store marketplace (additive; legacy Product / BusinessProfile unchanged)
// ---------------------------------------------------------------------------

/// Platform-wide catalog: name, images, category, brand live here only.
model GlobalProduct {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  description   String?
  categoryId    String?
  brand         String?
  imageUrl      String?
  imageKey      String?
  imageCardUrl  String?
  imageCardKey  String?
  imageThumbUrl String?
  imageThumbKey String?
  /// Extra gallery entries: [{ url, cardUrl, thumbUrl, sortOrder }]
  imagesJson    Json            @default("[]")
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  /// Set during Stage 4 migration from legacy Product.id.
  legacyProductId String?       @unique
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants      GlobalVariant[]
  storeListings StoreProduct[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
}

/// Catalog variant (e.g. type=volume, value=1L). Stores set price/stock on StoreProduct.
model GlobalVariant {
  id              String         @id @default(cuid())
  globalProductId String
  type            String
  value           String
  imageUrl        String?
  sku             String?
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  /// Set during Stage 4 migration from legacy ProductVariant.id.
  legacyVariantId String?        @unique
  globalProduct   GlobalProduct  @relation(fields: [globalProductId], references: [id], onDelete: Cascade)
  storeListings   StoreProduct[]

  @@unique([globalProductId, type, value])
  @@index([globalProductId, isActive])
  @@index([sku])
}

/// Marketplace store (maps from BusinessProfile during migration).
model Store {
  id                String           @id @default(cuid())
  name              String
  slug              String           @unique
  logoUrl           String?
  bannerUrl         String?
  address           String?
  phone             String?
  latitude          Decimal?         @db.Decimal(10, 7)
  longitude         Decimal?         @db.Decimal(10, 7)
  deliveryPrice     Int              @default(0)
  minOrderPrice     Int              @default(0)
  isActive          Boolean          @default(true)
  isFeatured        Boolean          @default(false)
  sortOrder         Int              @default(0)
  ownerUserId       String?
  businessProfileId String?          @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  owner             User?            @relation("StoreOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  businessProfile   BusinessProfile? @relation(fields: [businessProfileId], references: [id], onDelete: SetNull)
  scopedStaff       User[]           @relation("StoreStaffScope")
  storeProducts     StoreProduct[]
  orders            Order[]

  @@index([isActive])
  @@index([ownerUserId])
}

/// Per-store listing: price, stock, cashback, visibility (no duplicate catalog text).
model StoreProduct {
  id               String         @id @default(cuid())
  storeId          String
  globalProductId  String
  globalVariantId  String?
  price            Int
  oldPrice         Int?
  stock            Int            @default(0)
  cashbackType     CashbackType   @default(NONE)
  cashbackValue    Int            @default(0)
  isVisible        Boolean        @default(true)
  isTop            Boolean        @default(false)
  topOrder         Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  /// Set during Stage 4 migration from legacy Product.id.
  legacyProductId  String?        @unique
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  globalProduct    GlobalProduct  @relation(fields: [globalProductId], references: [id], onDelete: Cascade)
  globalVariant    GlobalVariant? @relation(fields: [globalVariantId], references: [id], onDelete: SetNull)

  @@index([storeId, isVisible])
  @@index([storeId, isTop, topOrder])
  @@index([globalProductId])
  @@index([globalVariantId])
}
